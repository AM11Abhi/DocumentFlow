# ==========================================================
# DocumentFlow - Docker Compose Environment Configuration
# ==========================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=documentflow

# Host port mapping for containerized PostgreSQL (defaults to 5433 to avoid local 5432 conflict)
POSTGRES_HOST_PORT=5433

# Application Published Ports
API_PORT=8000
FRONTEND_PORT=3000

# Frontend API Target (resolved by the browser on the host machine)
VITE_API_BASE_URL=http://localhost:8000
