# Database connection URL
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/documentflow

# Local storage path for uploaded files
UPLOAD_DIR=uploads

# Maximum allowed file upload size (in bytes)
MAX_FILE_SIZE_BYTES=10485760

# Redis connection details
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_QUEUE_NAME=document_processing_queue
